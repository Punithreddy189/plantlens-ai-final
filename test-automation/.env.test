# Appium & Device Configuration
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_DRIVER=APM
APPIUM_DRIVER_FALLBACK=UiAutomator2

# Android App Details
APP_PACKAGE=com.plantlens.ai
APP_ACTIVITY=com.plantlens.ai.activities.SplashActivity
APK_PATH=../PlantLensAI-main/app/build/intermediates/apk/debug/app-debug.apk
DEVICE_NAME=Pixel_7_API_34
PLATFORM_VERSION=14.0
AUTOMATION_NAME=UiAutomator2

# Web & API Target Endpoints
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
SERVERLESS_API_URL=http://localhost:3000/api

# Test Reporting
REPORT_DIR=./reports
EXCEL_REPORT_NAME=APM_E2E_Report.xlsx
HTML_REPORT_NAME=index.html
LOG_LEVEL=info
CAPTURE_SCREENSHOT_ON_FAILURE=true

# AI Assistant
AI_DISCOVERY_ENABLED=true
AI_MODEL=gemini-1.5-pro-vision-mock
