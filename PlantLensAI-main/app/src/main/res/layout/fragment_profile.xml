<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- 1. Profile Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorOutline"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:contentDescription="User Avatar"
                        android:background="@drawable/circle_button_bg"
                        android:backgroundTint="@color/accent_light"
                        android:padding="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:id="@+id/profileDisplayName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Guest Gardener"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/profileEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="guest@plantlens.ai"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_profile"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:cornerRadius="8dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Heading: Daily Usage -->
        <TextView
            android:id="@+id/usageHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/daily_usage_title"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/profileCard"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- 2. Daily Usage Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/myUsageCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorOutline"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/usageHeading">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Scans Today Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scans_today"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/userScansToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0 / 50"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                </RelativeLayout>

                <!-- Remaining Scans Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/remaining_scans"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/userRemainingScans"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="50"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                </RelativeLayout>

                <!-- Plants Saved Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plants_saved_label"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/userPlantsSaved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                </RelativeLayout>

                <!-- Last Scan Date Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/last_scan_date"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/userLastScanDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Never"
                        android:textColor="@color/accent"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                </RelativeLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Heading: Achievements -->
        <TextView
            android:id="@+id/achievementsHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/milestones_title"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/myUsageCard"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- 3. Achievements Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/achievementsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorOutline"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/achievementsHeading">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Badges Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:weightSum="5">

                    <!-- First Plant Saved -->
                    <LinearLayout
                        android:id="@+id/badgeFirstPlant"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌱"
                            android:textSize="24sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/achievement_first_saved"
                            android:textSize="9sp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>

                    <!-- 10 Plants Identified -->
                    <LinearLayout
                        android:id="@+id/badgeTenPlants"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌿"
                            android:textSize="24sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/achievement_10_plants"
                            android:textSize="9sp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>

                    <!-- 50 Successful Scans -->
                    <LinearLayout
                        android:id="@+id/badgeFiftyScans"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌳"
                            android:textSize="24sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/achievement_50_scans"
                            android:textSize="9sp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>

                    <!-- Plant Expert -->
                    <LinearLayout
                        android:id="@+id/badgePlantExpert"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏆"
                            android:textSize="24sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/achievement_expert"
                            android:textSize="9sp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>

                    <!-- Multi-Language Explorer -->
                    <LinearLayout
                        android:id="@+id/badgeLangExplorer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌍"
                            android:textSize="24sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/achievement_explorer"
                            android:textSize="9sp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Heading: Settings -->
        <TextView
            android:id="@+id/prefsHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/achievementsCard"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- 4. Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/themePreferencesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorOutline"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/prefsHeading">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Theme Selector Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_mode"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:layout_centerVertical="true"/>

                    <Spinner
                        android:id="@+id/themeSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?android:attr/selectableItemBackground"/>

                </RelativeLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutline"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Language Selector Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/language"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:layout_centerVertical="true"/>

                    <Spinner
                        android:id="@+id/languageSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?android:attr/selectableItemBackground"/>

                </RelativeLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/debugOverlayDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutline"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Debug Overlay Toggler Row -->
                <RelativeLayout
                    android:id="@+id/debugOverlayRow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/debug_overlay"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:layout_centerVertical="true"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/debugOverlaySwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"/>

                </RelativeLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Heading: Export -->
        <TextView
            android:id="@+id/exportHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/export_title"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/themePreferencesCard"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- 5. Export Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/exportCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorOutline"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/exportHeading">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportPDF"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/export_pdf"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportCSV"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/export_csv"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Admin Dashboard Navigation Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminAnalyticsButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/admin_dashboard"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/exportCard"/>

        <!-- Log Out Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/log_out"
            android:textColor="@color/white"
            android:backgroundTint="@color/error"
            android:layout_marginTop="16dp"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/adminAnalyticsButton"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
