<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Photo thumbnail card wrapper for guaranteed rounded corners on all devices -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTimelinePhoto"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:cardCornerRadius="10dp"
            app:strokeWidth="0dp"
            app:cardElevation="0dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/ivTimelinePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerCrop"
                android:contentDescription="Growth Progress Photo"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/tvTimelineDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="June 15, 2026"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTimelineMetrics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Height: 18 cm | Health: 91%"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvTimelineNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Healthy growth, new leaves splitting beautifully."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.1"/>

            <TextView
                android:id="@+id/tvTimelineMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assessment: Health Assessment Engine"
                android:textColor="#718096"
                android:textSize="10sp"
                android:textStyle="italic"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
