<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Confetti/Match badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/matchBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/accent_light">
            
            <TextView
                android:id="@+id/confidenceScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="98% Match Confidence"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Plant Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultPlantCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/resultPlantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peace Lily"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/resultScientificName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spathiphyllum wallisii"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:layout_marginTop="4dp"
                    android:gravity="center"/>

                <View
                    android:layout_width="80dp"
                    android:layout_height="1.5dp"
                    android:background="?attr/colorOutline"
                    android:layout_marginVertical="12dp"/>

                <TextView
                    android:id="@+id/resultCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category: Indoor Plant"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/resultWaterSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watering Cycle: Every 5 days"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Unrecognized Warning Layout (Shown ONLY if confidence < 60%) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/unrecognizedWarningCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/error"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFEBEB">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_rejected_title"
                    android:textColor="@color/error"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/unrecognizedWarningText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_rejected_desc"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:gravity="center"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Detailed Results Layout (Hidden if confidence < 60%) -->
        <LinearLayout
            android:id="@+id/detailedResultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Alternative Matches Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/top3Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alternative_matches_title"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Match 1 -->
                    <LinearLayout
                        android:id="@+id/top3Row1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/top3Row1Name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="1. Peace Lily"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/top3Row1Percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="92%"
                                android:textColor="@color/primary"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/top3Row1Progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:progress="92"
                            android:max="100"
                            android:progressTint="@color/primary"/>
                    </LinearLayout>

                    <!-- Match 2 -->
                    <LinearLayout
                        android:id="@+id/top3Row2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/top3Row2Name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="2. Anthurium"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <TextView
                                android:id="@+id/top3Row2Percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45%"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"/>
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/top3Row2Progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:progress="45"
                            android:max="100"
                            android:progressTint="@color/accent"/>
                    </LinearLayout>

                    <!-- Match 3 -->
                    <LinearLayout
                        android:id="@+id/top3Row3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/top3Row3Name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="3. Cast Iron Plant"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <TextView
                                android:id="@+id/top3Row3Percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18%"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"/>
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/top3Row3Progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:progress="18"
                            android:max="100"
                            android:progressTint="?attr/colorOnSurfaceVariant"/>
                    </LinearLayout>

                    <!-- Match 4 -->
                    <LinearLayout
                        android:id="@+id/top3Row4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/top3Row4Name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="4. Aloe Vera"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <TextView
                                android:id="@+id/top3Row4Percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12%"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"/>
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/top3Row4Progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:progress="12"
                            android:max="100"
                            android:progressTint="?attr/colorOnSurfaceVariant"/>
                    </LinearLayout>

                    <!-- Match 5 -->
                    <LinearLayout
                        android:id="@+id/top3Row5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/top3Row5Name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="5. Snake Plant"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <TextView
                                android:id="@+id/top3Row5Percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8%"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"/>
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/top3Row5Progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:progress="8"
                            android:max="100"
                            android:progressTint="?attr/colorOnSurfaceVariant"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Plant Health & Disease Diagnostics Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/diseaseDiagnosisCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header with Title & Engine Tag -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/disease_diagnostic_title"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/diagnosticEngineBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/engine_tflite_label"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:background="@drawable/edit_text_bg"/>
                    </LinearLayout>

                    <!-- Health Status Indicator Banner -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/healthStatusCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/success_background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/healthStatusIcon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🌿"
                                    android:textSize="26sp"
                                    android:layout_marginEnd="10dp"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/healthStatusTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/foliage_healthy_title"
                                        android:textColor="@color/success"
                                        android:textSize="14sp"
                                        android:textStyle="bold"/>

                                    <TextView
                                        android:id="@+id/diseaseNameText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/healthy_foliage"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="12sp"
                                        android:layout_marginTop="2dp"/>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/healthScorePercentText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="95%"
                                    android:textColor="@color/success"
                                    android:textSize="20sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/healthScoreProgressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="8dp"
                                android:progress="95"
                                android:max="100"
                                android:progressTint="@color/success"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Disease Severity Badge -->
                    <TextView
                        android:id="@+id/diseaseSeverityBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Severity: None"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/edit_text_bg"/>

                    <!-- Symptoms & Observations Section -->
                    <LinearLayout
                        android:id="@+id/diseaseObservationsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/symptoms_header"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/diseaseObservationsText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No visible pathogen lesions or chlorosis detected."
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.2"/>
                    </LinearLayout>

                    <!-- Treatment & Recovery Plan Section -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/treatmentPlanCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutline"
                        app:cardBackgroundColor="?attr/colorSurface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/treatment_plan_header"
                                android:textColor="@color/primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:id="@+id/treatmentPlanText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/standard_care_maintenance"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                android:lineSpacingMultiplier="1.2"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Offline Diagnostic Notice -->
                    <TextView
                        android:id="@+id/offlineDiagnosticNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/offline_diagnosis_notice"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Smart Weather & Live Watering Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/weatherWateringCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_watering_title"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/weatherLocationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 Current Location"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/weatherTempText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🌡 Temp: --"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <TextView
                                android:id="@+id/weatherHumidityText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="💧 Humidity: --"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:id="@+id/weatherRainText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🌧 Rain Chance: --"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <TextView
                                android:id="@+id/weatherUvText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="☀ UV Index: --"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/weatherWindText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💨 Wind Speed: --"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutline"
                        android:layout_marginVertical="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/watering_recommendation_label"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/wateringAdjustText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Optimal weather conditions. Water every 5 days."
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



            <!-- Save to Garden Inputs -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/saveInputsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/save_to_garden_title"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nickname_hint"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nicknameInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveToGardenButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/save_plant_btn"
                        android:backgroundTint="@color/primary"
                        android:layout_marginTop="16dp"
                        app:cornerRadius="10dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Identification Feedback System -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/feedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_question"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCorrect"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="@string/correct_btn"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/primary"
                            android:layout_marginEnd="6dp"
                            app:cornerRadius="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIncorrect"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="@string/incorrect_btn"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/error"
                            android:layout_marginStart="6dp"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Action Row -->
        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewDetailsButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:text="@string/details_catalog_btn"
                android:textColor="@color/primary"
                android:layout_marginEnd="6dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryScanButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/scan_again_btn"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginStart="6dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="10dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
