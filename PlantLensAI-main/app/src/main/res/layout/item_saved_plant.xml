<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Thumbnail image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/savedPlantThumbnail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                android:src="@drawable/plantlens_logo"/>

            <!-- Title & subtitle block -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/savedPlantThumbnail"
                android:layout_toStartOf="@id/deleteSavedPlantButton"
                android:layout_marginStart="12dp"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/savedPlantNickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Split Leaf"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/savedPlantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monstera deliciosa"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/savedPlantDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved: 30 Aug 2026, 09:05 PM"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Trash delete icon -->
            <ImageButton
                android:id="@+id/deleteSavedPlantButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/error"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove Plant" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:layout_marginVertical="12dp"/>

        <!-- Water dates grid row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/itemWaterButton"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/savedLastWateredText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Watered: 2 mins ago"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/savedNextWaterText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next Water: in 7 days"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Inline 'Water' action button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/itemWaterButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/water_action_label"
                android:textSize="11sp"
                android:backgroundTint="@color/accent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp"
                style="@style/Widget.Material3.Button"/>

        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
