<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- CameraX Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Transparent Overlay Mask with Center Frame Guideline -->
    <View
        android:id="@+id/dimmingMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Center leaf framing guide target -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/targetFrame"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/accent"
        app:strokeWidth="2.5dp"
        app:cardBackgroundColor="#00000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <!-- Framing inner helper -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/align_leaf_instruction"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#AA121815"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"/>
            
    </com.google.android.material.card.MaterialCardView>

    <!-- User Guidance Overlay -->
    <LinearLayout
        android:id="@+id/userGuidanceLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/targetFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/guidanceTextLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/move_closer_instruction"
            android:textColor="@color/accent_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#AA121815"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"/>

        <TextView
            android:id="@+id/guidanceTextLine2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fill_frame_instruction"
            android:textColor="@color/accent_light"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:background="#AA121815"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"/>
    </LinearLayout>

    <!-- Scanner prompt text -->
    <TextView
        android:id="@+id/scannerHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scan_pipeline_title"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Premium Debug Info Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/debugOverlayCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#B3121815"
        app:layout_constraintTop_toBottomOf="@id/scannerHeading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/debugResolutionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resolution_label"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/debugBrightnessText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brightness_label"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/debugBlurText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/blur_score_label"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/debugStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_pending"
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Premium Bottom Actions Row -->
    <LinearLayout
        android:id="@+id/scannerActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/captureButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/scan_plant_btn"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconTint="@color/white"
            app:cornerRadius="14dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/galleryButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/upload_image_btn"
            android:textColor="@color/primary"
            android:backgroundTint="@color/white"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconTint="@color/primary"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="14dp"/>

    </LinearLayout>

    <!-- TFLite Inference loading overlay -->
    <LinearLayout
        android:id="@+id/scanLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC121815"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@color/accent"
            style="?android:attr/progressBarStyleLarge"/>

        <TextView
            android:id="@+id/loadingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tflite_inference"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pipeline_processing"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
