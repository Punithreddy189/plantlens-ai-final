<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- Scrollable plant catalog details container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="120dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Plant Image Header -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/detailPlantImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                android:layout_marginBottom="16dp"
                android:src="@drawable/plantlens_logo"/>

            <!-- Profile Header -->
            <TextView
                android:id="@+id/detailPlantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monstera"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailScientificName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monstera deliciosa"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:textStyle="italic"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/detailCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indoor • Sage Green"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:background="@color/accent_light"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>

            <!-- Care Instructions outline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/care_guidelines_title"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"/>

            <TextView
                android:id="@+id/detailCareTips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Provide bright, indirect light.\n• Wipe dust off leaves weekly."
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.25"/>

            <!-- Advantages -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/key_advantages_title"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/detailAdvantages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Air purifying properties.\n• Quick propagation splits."
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.25"/>

            <!-- Disadvantages -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/disadvantages_toxicity_title"
                android:textColor="@color/error"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/detailDisadvantages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Mildly toxic to cats and dogs."
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.25"/>

            <!-- Local Names Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/localNamesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/local_names_title"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/detailLocalNames"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/loading_local_names"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Plant Uses Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/plantUsesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plant_uses_title"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/detailPlantUses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/loading_plant_uses"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Plant Health & Disease Diagnostics Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailDiseaseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/disease_diagnostic_title"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Health Status Banner -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/detailHealthStatusCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/success_background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/detailHealthStatusIcon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🌿"
                                    android:textSize="26sp"
                                    android:layout_marginEnd="10dp"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/detailHealthStatusTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/foliage_healthy_title"
                                        android:textColor="@color/success"
                                        android:textSize="14sp"
                                        android:textStyle="bold"/>

                                    <TextView
                                        android:id="@+id/detailDiseaseNameText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/healthy_foliage"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="12sp"
                                        android:layout_marginTop="2dp"/>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/detailHealthScoreText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100%"
                                    android:textColor="@color/success"
                                    android:textSize="20sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/detailHealthProgressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="8dp"
                                android:progress="100"
                                android:max="100"
                                android:progressTint="@color/success"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Symptoms & Observations -->
                    <LinearLayout
                        android:id="@+id/detailDiseaseObservationsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/symptoms_header"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/detailDiseaseObservationsText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Healthy foliar integrity recorded in diagnostic log."
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.2"/>
                    </LinearLayout>

                    <!-- Treatment & Care Recommendation -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/detailTreatmentCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutline"
                        app:cardBackgroundColor="?attr/colorSurface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/treatment_plan_header"
                                android:textColor="@color/primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:id="@+id/detailTreatmentText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/standard_care_maintenance"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                android:lineSpacingMultiplier="1.2"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Smart Weather Care Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailWeatherCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_care_title"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/detailWeatherTemp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🌡 Temp: --"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <TextView
                                android:id="@+id/detailWeatherHumidity"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="💧 Humidity: --"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:id="@+id/detailWeatherRain"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="☔ Rain Chance: --"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <TextView
                                android:id="@+id/detailWeatherUv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="☀ UV Index: --"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/detailWeatherWind"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💨 Wind Speed: --"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailWeatherRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/loading_weather_care"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Saved Garden Progress Dashboard Container (Visible ONLY if saved) -->
            <LinearLayout
                android:id="@+id/gardenDashboardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutline"
                    android:layout_marginBottom="24dp"/>

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/garden_analytics_title"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvDashboardWateringInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last watered: Today | Next watering in 3 days"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="16dp"/>

                <!-- My Plant Journey Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/plantJourneyCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    app:cardBackgroundColor="?attr/colorSurface"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_plant_journey"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3"
                            android:layout_marginBottom="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/first_scan"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvFirstScanDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/total_scans"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvTotalScansCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/health_trend"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvHealthTrend"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/stable_trend"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHealthProgression"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Health Score Progression: --"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chart Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/growth_curves_title"
                            android:textColor="#34D399"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="8dp"/>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/growthChart"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Care Reminders Config Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/careRemindersCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    app:cardBackgroundColor="?attr/colorSurface"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/care_reminders_title"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="12dp"/>

                        <!-- Water Reminder Switch & Interval -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchWaterReminder"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/watering_reminder_switch"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <EditText
                                android:id="@+id/etWaterInterval"
                                android:layout_width="50dp"
                                android:layout_height="wrap_content"
                                android:hint="7"
                                android:inputType="number"
                                android:textSize="13sp"
                                android:gravity="center"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/days_suffix"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <!-- Fertilizer Reminder Switch & Interval -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchFertilizerReminder"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/fertilizer_reminder_switch"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <EditText
                                android:id="@+id/etFertilizerInterval"
                                android:layout_width="50dp"
                                android:layout_height="wrap_content"
                                android:hint="30"
                                android:inputType="number"
                                android:textSize="13sp"
                                android:gravity="center"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/days_suffix"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <!-- Repot Reminder Switch & Interval -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchRepotReminder"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/repot_reminder_switch"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <EditText
                                android:id="@+id/etRepotInterval"
                                android:layout_width="50dp"
                                android:layout_height="wrap_content"
                                android:hint="180"
                                android:inputType="number"
                                android:textSize="13sp"
                                android:gravity="center"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/days_suffix"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <!-- Pruning Reminder Switch & Interval -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchPruningReminder"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/pruning_reminder_switch"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                            <EditText
                                android:id="@+id/etPruningInterval"
                                android:layout_width="50dp"
                                android:layout_height="wrap_content"
                                android:hint="90"
                                android:inputType="number"
                                android:textSize="13sp"
                                android:gravity="center"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/days_suffix"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <!-- Save Config Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveReminders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/apply_reminders_btn"
                            style="@style/Widget.Material3.Button"
                            android:textSize="12sp"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Growth Log Input Form Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/log_progress_title"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"/>

                        <!-- Height Input -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilHeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            app:hintEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etHeight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/height_input_hint"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Health Score Input -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilHealth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            app:hintEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etHealth"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/health_input_hint"
                                android:inputType="number"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Notes Input -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            app:hintEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNotes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/notes_input_hint"
                                android:inputType="textShortMessage"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Photo selector row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelectPhoto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/select_photo_btn"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/tvSelectedPhotoPath"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/no_photo_selected"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp"
                                android:layout_marginStart="12dp"
                                android:maxLines="1"
                                android:ellipsize="middle"/>
                        </LinearLayout>

                        <!-- Submit Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/persist_log_btn"
                            android:layout_marginTop="16dp"
                            app:cornerRadius="8dp"
                            android:backgroundTint="@color/primary"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Historical Timeline Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chronological_logs_title"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- Timeline List Recycler -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGrowthTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="140dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>



</androidx.coordinatorlayout.widget.CoordinatorLayout>
