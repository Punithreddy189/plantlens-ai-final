<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!-- Error Icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌"
            android:textSize="56sp"
            android:gravity="center" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Non-Plant Detected"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detected Object:"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <!-- Detected Object -->
        <TextView
            android:id="@+id/detectedObjectText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Laptop"
            android:textColor="@color/error"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please scan a plant leaf to perform botanical classification and health analysis."
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanAgain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Scan Again"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            android:layout_marginTop="24dp"
            app:cornerRadius="12dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
