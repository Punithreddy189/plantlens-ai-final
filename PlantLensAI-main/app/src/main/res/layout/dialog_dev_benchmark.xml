<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛠️ AI Performance Benchmark"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On-Device Model Telemetry Diagnostics"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <!-- Active Model Latency Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?android:attr/windowBackground"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Scan Performance"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Device Model:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/devDeviceModel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.8"
                        android:text="Google Pixel 7"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Crop Type Mode:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/devCropType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.8"
                        android:text="LEAF"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Detection Confidence:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/devDetectionConf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.8"
                        android:text="94.5%"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutline"
                    android:layout_marginVertical="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Detection Time:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/devDetectionTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="35 ms"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Classification Time:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/devClassificationTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="142 ms"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Total Pipeline Latency:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/devTotalLatency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="177 ms"
                        android:textColor="@color/success"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Persisted Scan Analytics Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?android:attr/windowBackground"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan History Diagnostics (SharedPreferences)"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Total Attempted Scans:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/devAnalyticsTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="0"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Successful Matches:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/devAnalyticsSuccess"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="0"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Rejected / Quality Fails:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/devAnalyticsRejected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="0"
                        android:textColor="@color/error"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Average Scan Confidence:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/devAnalyticsAvgConf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="0.0%"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Average Processing Speed:"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/devAnalyticsAvgTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="0 ms"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Top 5 predictions list card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?android:attr/windowBackground"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Complete Top-5 Class Probabilities"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/devPredictionsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Monstera deliciosa - 92.4%\n2. Spathiphyllum wallisii - 5.1%\n3. Aloe vera - 1.2%"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismissBenchmark"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Close Telemetry Dialog"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            app:cornerRadius="10dp"/>

    </LinearLayout>
</ScrollView>
